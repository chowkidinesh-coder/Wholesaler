# Copy this file to ".env" (same folder) and fill in YOUR OWN values. The easy way: run "npm run setup-env" and it writes .env for you.
# .env is never committed to git and must never be shared.

# PostgreSQL connection:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has special characters (@ # $ % / : ?) write them URL-encoded (@ = %40, # = %23, $ = %24, % = %25).
DATABASE_URL="postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/wholesale_market"

# A long random secret that signs the login cookies (at least 32 characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# Set both to true once the site runs online on https:// behind a hosting proxy
COOKIE_SECURE=false
TRUST_PROXY=false

# Local testing only: shows the forgot-password code on screen. Leave it out (or false) on a real server.
DEMO_OTP=true

# The shop's admin account, created once by "npm run db:init" (password: at least 8 characters)
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=
